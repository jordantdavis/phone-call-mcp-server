{
  "name": "phone-call-mcp-server",
  "version": "0.0.1",
  "description": "",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "phone-call-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --banner:js='#!/usr/bin/env node' --packages=external",
    "prepare": "npm run build",
    "check": "npm run lint && npm run format:check",
    "dev": "tsx src/index.ts",
    "format": "oxfmt src/",
    "format:check": "oxfmt --check src/",
    "inspect": "npm run build && mcp-inspector node dist/index.js",
    "lint": "oxlint src/",
    "lint:fix": "oxlint --fix src/",
    "start": "npm run build && node dist/index.js",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=24"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^0.20.0",
    "@types/node": "^25.2.3",
    "@vitest/coverage-v8": "^4.0.18",
    "esbuild": "^0.27.3",
    "oxfmt": "^0.32.0",
    "oxlint": "^1.47.0",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "twilio": "^5.12.1",
    "zod": "^4.3.6"
  }
}
